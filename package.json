{
  "name": "librium-desktop",
  "version": "0.5.3",
  "description": "HTTP and HTTPS traffic inspector",
  "author": "Librium",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:core": "node scripts/build-core.cjs",
    "dist": "npm run build:core && electron-builder --publish never",
    "dist:win": "npm run build:core && electron-builder --win --publish never",
    "dist:mac": "npm run build:core && electron-builder --mac --publish never",
    "test:ui": "node scripts/ui-smoke.cjs",
    "test:electron": "electron scripts/electron-smoke.cjs"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "http-proxy-agent": "^9.1.0",
    "jsdom": "^29.1.1",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "local.librium.desktop",
    "productName": "Librium",
    "directories": {
      "output": "dist/v0.5.3"
    },
    "files": [
      "desktop/**/*",
      "ui/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": true,
      "icon": "desktop/assets/icon.ico",
      "extraResources": [
        {
          "from": "target/release/librium.exe",
          "to": "core/librium.exe"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "desktop/assets/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "target/release/librium",
          "to": "core/librium"
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "asar": true
  }
}
